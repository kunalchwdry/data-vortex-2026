__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
.DS_Store

# regenerable, but keep the artefacts that ARE the submission
!output/*.pdf
!output/screenshots/
!output/figures/
!data/clean/*.csv
!data/clean/*.json
!data/clean/*.md

# scratch renderings from PDF verification
output/_*.png
output/social_engine.db

# form-upload copies, regenerated by src/make_submission.py
submission/*
# ...except the Phase-2 upload set: these ARE the submission, so the team needs
# to be able to download them from the repo. Regenerate with
# src/make_submission_phase2.py (deterministic apart from query timings).
!submission/phase2/
# Round-2 deliverable copies are NOT tracked: canonical files live in
# models/round2/, output/round2/ and notebooks/; the form upload set is
# submission/round2_form_upload/. run_round2.sh still regenerates
# submission/round2/ locally for convenience -- it just stays untracked.
# One-file-per-slot copies for the official Google Form (max 10 MB each):
# the 4 model .pkl files are bundled into a single zip for the model slot.
!submission/round2_form_upload/

# editor / notebook runtime droppings from anyone's machine
.ipython/
.jupyter/
*.sqlite

# Round 3: parked dry-run artifacts + scratch score frame (regenerated)
output/round3/smoke/
output/round3/quick_score.json

# regenerable score frame (analyze.py se banta hai)
output/round3/scored.csv
